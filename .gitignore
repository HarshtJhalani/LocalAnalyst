# ============================================================
# Text-to-SQL Data Analyst - .gitignore
# ============================================================

# ---- Secrets (never commit) --------------------------------
.env
.env.*
!.env.example

# ---- Virtual environment -----------------------------------
.venv/
venv/
env/

# ---- Python ------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Dataset workspaces (uploaded data, results, chats) ----
datasets/

# ---- Notebook outputs and logs -----------------------------
data/output_data/
data/logs/
*.log

# ---- Jupyter -----------------------------------------------
.ipynb_checkpoints/

# ---- Editors / OS ------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Temporary files ---------------------------------------
*.tmp

# ---- Claude Code local settings ----------------------------
.claude/

# ---- Document review reports (working notes) ---------------
zoom_out_report.md
comprehension_report.md
critic_report.md
intermediate_zoom_out_report.md
goldfish_review_report.md

# ---- Streamlit secrets (config.toml stays tracked) ---------
.streamlit/secrets.toml

# ---- Test and tool caches ----------------------------------
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
