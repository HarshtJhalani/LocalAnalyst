# Copy this file to .env. .env is git-ignored.

# Where Ollama runs. Inside Docker use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# auto = detect (7B if it fits fully on the GPU, else 3B)
# gpu  = always qwen2.5:7b-instruct, cpu = always qwen2.5:3b-instruct
MODEL_PROFILE=auto
